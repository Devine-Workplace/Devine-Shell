#!/usr/bin/env bash
set -euo pipefail
SOURCE="$(readlink -f -- "${BASH_SOURCE[0]}")"
ROOT_DIR="$(cd -- "$(dirname -- "$SOURCE")/.." && pwd -P)"
QML_DIR="$HOME/.local/lib/qt6/qml"
export QML2_IMPORT_PATH="$QML_DIR${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export DEVINE_LIB_DIR="$HOME/.local/lib/devine"
export PYTHONPATH="$ROOT_DIR/cli/src${PYTHONPATH:+:$PYTHONPATH}"
PYTHON="${XDG_DATA_HOME:-$HOME/.local/share}/devine/venv/bin/python"
[[ -x "$PYTHON" ]] || PYTHON="$(command -v python3)"
exec "$PYTHON" -m devine "$@"
